void bubble(int tablica[])
{
    for (int j = 0; j < 10; j++)
    {
        for (int i = 0; i < 9; i++)
        {
            if (tablica[i] > tablica[i + 1])
            {
                int temp = tablica[i + 1];
                tablica[i + 1] = tablica[i];
                tablica[i] = temp;
            }
        }
    }

    for (int i = 0; i < 10; i++)
    {
        printf("%d element to: %d\n", i + 1, tablica[i]);
    }
}

void losowe(int tablica[])
{
    srand(time(NULL));
    for (int i = 0; i < 10; i++)
    {
        tablica[i] = rand() % 100 + 1;
    }
}
